<html>
    <head>
        <title> factorial</title>
    </head>
    <body>
        <h2> factorial</h2>
        <input type="number" id="num" placeholder="enter a num">
        <button onclick="fact()">check</button>
        <p id="result"></p>
        <script>
            function fact(){
                let n=Number(document.getElementById("num").value);
                let f=1;
                if(n<0 || !Number.isInteger(n)){
                    document.getElementById("result").innerHTML="invalid number";
                    return;
                }
                for(let i=1;i<=n;i++){
                    f=f*i;
                }
                document.getElementById("result").innerHTML=f;
            }
        </script>
    </body>
</html>
